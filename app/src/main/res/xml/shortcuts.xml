<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon for a "Talk to Nova" shortcut -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="talk"
        android:enabled="true"
        android:shortcutShortLabel="@string/talk_short"
        android:shortcutLongLabel="@string/talk_long">
        <intent
            android:action="com.nova.apex.wallpaper.TALK"
            android:targetPackage="com.nova.apex.wallpaper"
            android:targetClass="com.nova.apex.wallpaper.M" />
    </shortcut>
</shortcuts>
